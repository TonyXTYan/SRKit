__version__: str

# A three-vector on the way out: always a tuple of floats.
_Vec3 = tuple[float, float, float]

class _Vec3Like(Protocol):
    """A three-vector on the way in: any sequence of three numbers (a tuple, a list, a NumPy array)."""

    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> SupportsFloat: ...

# A NumPy float64 array when NumPy can be imported at the time of the call, otherwise a flat list of floats.
_Floats = Any
# Times: any sequence or buffer of numbers (a list, an array.array, a NumPy array of any shape).
_Times = Any
# Events: four numbers each (t, x, y, z), as an array of shape (n, 4), a sequence of 4-sequences, or flat.
_Events = Any

_SegmentKind = Literal["rest", "inertial", "hyperbolic", "steered", "burn", "circular", "null"]

class NoIntersection(Exception):
    """A light cone does not meet a worldline where it was asked to."""

class PrecisionLoss(ArithmeticError):
    """The answer cannot be given to the precision the function promises."""

