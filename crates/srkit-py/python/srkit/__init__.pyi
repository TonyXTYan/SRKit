@final
class Segment:
    """One closed-form piece of a worldline, covering coordinate times t0 to t1."""

    @staticmethod
    def rest(t0: float, t1: float, p: _Vec3Like) -> Segment: ...
    @staticmethod
    def inertial(t0: float, t1: float, p0: _Vec3Like, v: _Vec3Like) -> Segment: ...
    @staticmethod
    def hyperbolic(
        t0: float, t1: float, p0: _Vec3Like, n: _Vec3Like, alpha: float, phi0: float = 0.0
    ) -> Segment: ...
    @staticmethod
    def steered(
        t0: float,
        t1: float,
        p0: _Vec3Like,
        v0: _Vec3Like,
        thrust: _Vec3Like,
        alpha: float,
        *,
        proper_velocity: bool = False,
    ) -> Segment: ...
    @staticmethod
    def burn(
        t0: float,
        t1: float,
        p0: _Vec3Like,
        n: _Vec3Like,
        phi0: float,
        alpha0: float,
        w: float = 1.0,
    ) -> Segment: ...
    @staticmethod
    def circular(
        t0: float,
        t1: float,
        centre: _Vec3Like,
        r: float,
        omega: float,
        e1: _Vec3Like | None = None,
        e2: _Vec3Like | None = None,
        a0: float = 0.0,
    ) -> Segment: ...
    @staticmethod
    def null(t0: float, t1: float, p0: _Vec3Like, n: _Vec3Like) -> Segment: ...
    @staticmethod
    def jump(t0: float, p0: _Vec3Like, p1: _Vec3Like) -> Segment: ...
    @property
    def t0(self) -> float: ...
    @property
    def t1(self) -> float: ...
    @property
    def kind(self) -> _SegmentKind: ...
    @property
    def is_null(self) -> bool: ...
    @property
    def params(self) -> dict[str, float | _Vec3]: ...
    def with_t1(self, t1: float) -> Segment: ...
    def at(self, t: float) -> tuple[_Vec3, _Vec3]: ...
    def dtau(self, t: float) -> float: ...
    def t_of_tau(self, s: float) -> float: ...
    def at_tau(self, s: float) -> TauState: ...
    def proper_duration(self) -> float: ...
    def vmax(self) -> float: ...
    def recv(
        self, event_t: float, event_x: _Vec3Like, lo: float = ..., hi: float = ...
    ) -> float: ...
    def send(
        self, event_t: float, event_x: _Vec3Like, lo: float = ..., hi: float = ...
    ) -> float: ...
    def horizon_margin(
        self, event_t: float, event_x: _Vec3Like, past: bool = False
    ) -> float | None: ...
    def rindler_horizon(self) -> RindlerHorizon | None: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]

