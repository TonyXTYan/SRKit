class Worldline:
    """A worldline: segments in order of their start times, with proper time carried along the chain."""

    def __new__(
        cls,
        segments: Iterable[Segment],
        anchor_t: float | None = None,
        anchor_tau: float = 0.0,
    ) -> Self: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> Segment: ...
    def __iter__(self) -> Iterator[Segment]: ...
    @property
    def segments(self) -> tuple[Segment, ...]: ...
    @property
    def tau0s(self) -> tuple[float, ...]: ...
    @property
    def has_null(self) -> bool: ...
    def find(self, t: float) -> int: ...
    def find_tau(self, tau: float) -> int: ...
    def at(self, t: float) -> tuple[_Vec3, _Vec3]: ...
    def tau(self, t: float) -> float: ...
    def t_of_tau(self, tau: float) -> float: ...
    def at_tau(self, tau: float) -> TauState: ...
    def vmax(self) -> float: ...
    def recv(self, event_t: float, event_x: _Vec3Like) -> float: ...
    def send(self, event_t: float, event_x: _Vec3Like) -> float: ...
    def seen_from(self, event_t: float, event_x: _Vec3Like) -> tuple[float, _Vec3, _Vec3]: ...
    def check_continuity(self, position_tol: float = 1e-9, velocity_tol: float = 1e-9) -> None: ...
    def is_continuous(self, position_tol: float = 1e-9, velocity_tol: float = 1e-9) -> bool: ...
    def radar(self, event_t: float, event_x: _Vec3Like) -> Radar: ...
    def light_cone_coordinates(self, event_t: float, event_x: _Vec3Like) -> tuple[float, float]: ...
    def at_many(self, ts: _Times) -> tuple[_Floats, _Floats]: ...
    def tau_many(self, ts: _Times) -> _Floats: ...
    def recv_many(self, events: _Events) -> _Floats: ...
    def send_many(self, events: _Events) -> _Floats: ...

